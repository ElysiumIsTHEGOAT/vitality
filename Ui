local function gradient( Parent, Top, Bottom, Rotation )
	local Grad = Instance.new( "UIGradient" );
	Grad.Rotation = Rotation or 90;
	Grad.Color = ColorSequence.new( Color3.fromRGB( Top, Top, Top ), Color3.fromRGB( Bottom, Bottom, Bottom ) );
	Grad.Name = "\0";
	Grad.Parent = Parent;
	return Grad;
end;

local function accentGradient( Parent, Rotation )
	local Grad = Instance.new( "UIGradient" );
	Grad.Rotation = Rotation or 90;
	Grad.Color = ColorSequence.new( {
		ColorSequenceKeypoint.new( 0, Color3.fromRGB( 255, 255, 255 ) );
		ColorSequenceKeypoint.new( 0.5, Color3.fromRGB( 214, 214, 214 ) );
		ColorSequenceKeypoint.new( 1, Color3.fromRGB( 168, 168, 168 ) );
	} );
	Grad.Name = "\0";
	Grad.Parent = Parent;
	return Grad;
end;

local function tween( Object, Properties, Time, Style, Direction )
	local Info = Smooth;
	if Time then Info = TweenInfo.new( Time, Style or Enum.EasingStyle.Quint, Direction or Enum.EasingDirection.Out ); end;
	local NewTween = TweenService : Create( Object, Info, Properties );
	NewTween : Play();
	return NewTween;
end;

