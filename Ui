local function httpGet( Url )
	local Success, Result = pcall( function()
		if syn and syn.request then return syn.request( { Url = Url; Method = "GET" } ).Body;
		elseif http and http.request then return http.request( { Url = Url; Method = "GET" } ).Body;
		elseif request then return request( { Url = Url; Method = "GET" } ).Body;
		elseif fluxus and fluxus.request then return fluxus.request( { Url = Url; Method = "GET" } ).Body;
		end;
		return game : HttpGet( Url );
	end );
	if not Success or not Result or Result == "" then
		warn( "[Vitality] HttpGet failed: " .. tostring( Result ) );
		return nil;
	end;
	return Result;
end;

function Library : NewFont( Name, Weight, Style, AssetId, FontUrl )
	local Success, Result = pcall( function()
		local Folder = Library.Directory .. "/Assets/";
		local FilePath = Folder .. AssetId;
		if not isfile( FilePath ) then
			local Data = httpGet( FontUrl );
			if not Data then error( "failed to download " .. tostring( FontUrl ) ); end;
			writefile( FilePath, Data );
		end;
		local FontFile = Folder .. Name .. ".font";
		if isfile( FontFile ) then delfile( FontFile ); end;
		writefile( FontFile, HttpService : JSONEncode( {
			name = Name;
			faces = { { name = "Regular"; weight = Weight; style = Style; assetId = getcustomasset( FilePath ); } };
		} ) );
		return Font.new( getcustomasset( FontFile ) );
	end );
	if not Success then
		warn( "[Vitality] failed to load font " .. tostring( Name ) .. ": " .. tostring( Result ) );
		return nil;
	end;
	return Result;
end;

