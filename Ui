local function connect( Signal, Callback )
	local Connection = Signal : Connect( Callback );
	table.insert( Library.Connections, Connection );
	return Connection;
end;

local function call( Callback, ... )
	if type( Callback ) ~= "function" then return end;
	local Success, Error = pcall( Callback, ... );
	if not Success then warn( "[Vitality] " .. tostring( Error ) ); end;
end;

local StrokeOrder = { "Outline 1", "Outline 3", "Outline 2", "Outline 4" };

local function strokes( Parent, Count )
	for Index = 1, ( Count or 4 ) do
		local Stroke = Instance.new( "UIStroke" );
		Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
		Stroke.LineJoinMode = Enum.LineJoinMode.Miter;
		Stroke.Color = Theme[ StrokeOrder[ Index ] ];
		Stroke.BorderOffset = UDim.new( 0, Index - 1 );
		Stroke.Name = "\0";
		Stroke.Parent = Parent;
	end;
end;

