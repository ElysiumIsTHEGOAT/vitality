	for _, Gui in pairs( Parent : GetChildren() ) do
		if Gui : IsA( "ScreenGui" ) and ( Gui.Name == "VitalityOverlay" or Gui.Name == "VitalityMain" or Gui.Name == "VitalityPopup" ) then
