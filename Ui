		Swatch.BackgroundColor3 = Color;
		Palette.BackgroundColor3 = Color3.fromHSV( Picker.H, 1, 1 );
		PaletteCursor.Position = UDim2.fromScale( Picker.S, 1 - Picker.V );
		HueCursor.Position = UDim2.fromScale( 0.5, Picker.H );
		Hex.Text = "#" .. Color : ToHex() : upper();
		Library.Flags[ Flag ] = Color;
		if Picker.OnChanged then Picker.OnChanged( Color ); end;
		if not Silent then call( Params.Callback, Color ); end;
	end;

	function Picker : Set( Color, Silent )
		if type( Color ) == "string" then
			local Success, Result = pcall( Color3.fromHex, Color );
			if not Success then return end;
			Color = Result;
		end;
		if typeof( Color ) ~= "Color3" then return end;
		Picker.H, Picker.S, Picker.V = Color : ToHSV();
		paint( Silent );
	end;

	function Picker : SetValue( Color ) Picker : Set( Color ); end;
	function Picker : Get() return Picker.Color; end;

	drag( PaletteHit, function( Mouse )
		local Position, Size = Palette.AbsolutePosition, Palette.AbsoluteSize;
		Picker.S = math.clamp( ( Mouse.X - Position.X ) / Size.X, 0, 1 );
		Picker.V = 1 - math.clamp( ( Mouse.Y - Position.Y ) / Size.Y, 0, 1 );
		paint();
	end );

	drag( HueHit, function( Mouse )
		local Position, Size = Hue.AbsolutePosition, Hue.AbsoluteSize;
		Picker.H = math.clamp( ( Mouse.Y - Position.Y ) / Size.Y, 0, 0.999 );
		paint();
	end );

