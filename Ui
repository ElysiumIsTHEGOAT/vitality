local WindowMethods = {};
WindowMethods.__index = WindowMethods;

function WindowMethods : Tab( Name )
	local Window = self;
	local Tab = setmetatable( { Name = Name }, TabMethods );

	Tab.Button = Instance.new( "TextButton" );
	Tab.Button.FontFace = Library.BoldFont;
	Tab.Button.TextSize = Library.TextSize;
	Tab.Button.Text = Name;
	Tab.Button.TextColor3 = Theme[ "Dim" ];
	Tab.Button.BackgroundTransparency = 1;
	Tab.Button.BorderSizePixel = 0;
	Tab.Button.AutoButtonColor = false;
	Tab.Button.Size = UDim2.new( 1, 0, 1, 0 );
	Tab.Button.LayoutOrder = #Window.Tabs + 1;
	Tab.Button.Name = "\0";
	Tab.Button.Parent = Window.TabList;
	textStroke( Tab.Button );

	Tab.Page = Instance.new( "Frame" );
	Tab.Page.BackgroundTransparency = 1;
	Tab.Page.Size = UDim2.fromScale( 1, 1 );
	Tab.Page.Visible = false;
	Tab.Page.BorderSizePixel = 0;
	Tab.Page.Name = "\0";
	Tab.Page.Parent = Window.Pages;

	Tab.Left = column( Tab.Page, true );
	Tab.Right = column( Tab.Page, false );

	function Tab : Select()
		if Window.Current == Tab then return end;
		closePopups();
		local Old = Window.Current;
		if Old then
			Old.Page.Visible = false;
			tween( Old.Button, { TextColor3 = Theme[ "Dim" ] }, 0.2 );
		end;
		Window.Current = Tab;
		Tab.Page.Position = UDim2.fromOffset( 0, 10 );
		Tab.Page.Visible = true;
		tween( Tab.Page, { Position = UDim2.fromOffset( 0, 0 ) }, 0.4 );
		tween( Tab.Button, { TextColor3 = Theme[ "Accent" ] }, 0.2 );
	end;

	connect( Tab.Button.MouseEnter, function()
		if Window.Current ~= Tab then tween( Tab.Button, { TextColor3 = Theme[ "Text" ] }, 0.15 ); end;
	end );
	connect( Tab.Button.MouseLeave, function()
		if Window.Current ~= Tab then tween( Tab.Button, { TextColor3 = Theme[ "Dim" ] }, 0.15 ); end;
	end );
	connect( Tab.Button.MouseButton1Click, function() Tab : Select(); end );

	table.insert( Window.Tabs, Tab );
	for _, Existing in Window.Tabs do
		Existing.Button.Size = UDim2.new( 1 / #Window.Tabs, 0, 1, 0 );
	end;
	if #Window.Tabs == 1 then Tab : Select(); end;
	return Tab;
end;

function WindowMethods : SetOpen( Bool )
	if self.Open == Bool then return end;
	self.Open = Bool;
	closePopups();
	if Bool then
		self.Root.Visible = true;
		self.Scale.Scale = 0.94;
		tween( self.Scale, { Scale = 1 }, 0.35 );
	else
		local Closing = tween( self.Scale, { Scale = 0.94 }, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In );
		Closing.Completed : Once( function()
			if not self.Open then
				self.Root.Visible = false;
				self.Scale.Scale = 1;
			end;
		end );
	end;
end;

function WindowMethods : Notify( Params ) Library : Notify( Params ); end;

