		if Y + PopupHeight > Viewport.Y - 6 then Y = Raw.Y - PopupHeight - 6; end;
		Popup.Position = UDim2.fromOffset( X, Y );
		Popup.Visible = true;
		Entry.Open = true;
	end;
	table.insert( Library.Popups, Entry );

	connect( Swatch.MouseButton1Click, function()
		if Entry.Open then Entry.Close() else Entry.Show() end;
	end );

	Picker : Set( Params.Default or White, true );
	Library.Options[ Flag ] = Picker;
	return Picker;
