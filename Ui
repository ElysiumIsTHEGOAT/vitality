local function keyName( Key )
	if not Key then return "None"; end;
	if Key == Enum.UserInputType.MouseButton1 then return "MB1"; end;
	if Key == Enum.UserInputType.MouseButton2 then return "MB2"; end;
	if Key == Enum.UserInputType.MouseButton3 then return "MB3"; end;
	return Key.Name;
end;

local function modeSelector( Parent, Keybind, OnSelect )
	local Entry = { Open = false; Anchor = Parent; };
	local Popup = Instance.new( "Frame" );
	Popup.Size = UDim2.fromOffset( 64, 68 );
	Popup.Visible = false;
	Popup.ZIndex = 5;
	Popup.BackgroundColor3 = Theme[ "Background" ];
	Popup.BorderSizePixel = 0;
	Popup.Name = "\0";
	Popup.Parent = PopupGui;
	Entry.Frame = Popup;
	strokes( Popup, 4 );
	gradient( Popup, 255, 200, 45 );

	local List = Instance.new( "UIListLayout" );
	List.Padding = UDim.new( 0, 0 );
	List.SortOrder = Enum.SortOrder.LayoutOrder;
	List.Name = "\0";
	List.Parent = Popup;

	local Pad = Instance.new( "UIPadding" );
	Pad.PaddingTop = UDim.new( 0, 4 );
	Pad.PaddingBottom = UDim.new( 0, 4 );
	Pad.PaddingLeft = UDim.new( 0, 2 );
	Pad.PaddingRight = UDim.new( 0, 2 );
	Pad.Name = "\0";
	Pad.Parent = Popup;

	local Options = { "Toggle", "Hold", "Always" };
	local OptionButtons = {};

	local function paint()
		for ModeName, Data in OptionButtons do
			local Active = ( ModeName == Keybind.Mode );
			tween( Data.Label, { TextColor3 = Active and Theme[ "Accent" ] or Theme[ "Text" ] }, 0.15 );
		end;
	end;

	for Index, ModeName in Options do
		local Option = Instance.new( "TextButton" );
		Option.Size = UDim2.new( 1, 0, 0, 20 );
		Option.BackgroundTransparency = 1;
		Option.LayoutOrder = Index;
		Option.BorderSizePixel = 0;
		Option.AutoButtonColor = false;
		Option.Text = "";
		Option.Name = "\0";
		Option.Parent = Popup;

		local Label = Instance.new( "TextLabel" );
		Label.FontFace = Library.BoldFont;
		Label.Text = ModeName;
		Label.TextSize = Library.TextSize;
		Label.TextColor3 = Theme[ "Text" ];
		Label.BackgroundTransparency = 1;
		Label.BorderSizePixel = 0;
		Label.Size = UDim2.fromScale( 1, 1 );
		Label.TextXAlignment = Enum.TextXAlignment.Center;
		Label.Name = "\0";
		Label.Parent = Option;
		textStroke( Label );

		OptionButtons[ ModeName ] = { Button = Option; Label = Label; };

		connect( Option.MouseEnter, function()
			if ModeName ~= Keybind.Mode then tween( Label, { TextColor3 = Theme[ "Dim" ] }, 0.15 ); end;
		end );
		connect( Option.MouseLeave, function()
			if ModeName ~= Keybind.Mode then tween( Label, { TextColor3 = Theme[ "Text" ] }, 0.15 ); end;
		end );
		connect( Option.MouseButton1Click, function()
			OnSelect( ModeName );
			paint();
			Entry.Close();
		end );
	end;

	function Entry.Close() Entry.Open = false; Popup.Visible = false; end;
	function Entry.Show()
		closePopups( Entry );
		paint();
		local Viewport = workspace.CurrentCamera.ViewportSize;
		local Raw = Parent.AbsolutePosition - getOrigin();
		local X = math.clamp( Raw.X, 6, math.max( Viewport.X - 64 - 6, 6 ) );
		local Y = Raw.Y + Parent.AbsoluteSize.Y + 4;
		if Y + 68 > Viewport.Y - 6 then Y = Raw.Y - 68 - 4; end;
		Popup.Position = UDim2.fromOffset( X, Y );
		Popup.Visible = true;
		Entry.Open = true;
	end;

	table.insert( Library.Popups, Entry );
	return Entry;
end;

local function keybind( Parent, Params )
	Params = Params or {};
	local Flag = Params.Flag or Params.Name or "Keybind";
	local Keybind = { Key = nil; Mode = Params.Mode or "Toggle"; Active = false; Listening = false; Value = nil; Flag = Flag; Name = Params.Name or Flag; };

	local Button = Instance.new( "TextButton" );
	Button.FontFace = Library.BoldFont;
	Button.TextSize = Library.TextSize;
	Button.Text = "None";
	Button.TextColor3 = Theme[ "Dim" ];
	Button.BackgroundTransparency = 1;
	Button.BorderSizePixel = 0;
	Button.AutoButtonColor = false;
	Button.Size = UDim2.new( 0, 0, 0, 16 );
	Button.AutomaticSize = Enum.AutomaticSize.X;
	Button.Name = "\0";
	Button.Parent = Parent;
	textStroke( Button );

	local function Refresh()
		Button.Text = Keybind.Listening and "..." or keyName( Keybind.Key );
		local Target = Keybind.Listening and Theme[ "Accent" ] or Theme[ "Dim" ];
		tween( Button, { TextColor3 = Target }, 0.15 );
		Library : RefreshKeybindHud();
	end;

	local function SyncLink()
		if Params.Link and typeof( Params.Link ) == "table" and Params.Link.Set then
			Params.Link : Set( Keybind.Active );
		end;
	end;

	function Keybind : SetActive( Bool )
		Keybind.Active = Bool and true or false;
		Library.Flags[ Flag ] = Keybind.Active;
		Library : RefreshKeybindHud();
	end;

	function Keybind : Press( Down )
		local Old = Keybind.Active;
		if Keybind.Mode == "Toggle" then
			if Down then Keybind.Active = not Keybind.Active; end;
		elseif Keybind.Mode == "Hold" then
			Keybind.Active = Down;
		else
			Keybind.Active = true;
		end;
		Library.Flags[ Flag ] = Keybind.Active;
		Keybind.Value = Keybind.Active;
		if Keybind.Active ~= Old then
			call( Params.Callback, Keybind.Active );
			SyncLink();
			Library : RefreshKeybindHud();
		end;
	end;

	function Keybind : Set( Key, Mode, Silent )
		if Mode then Keybind.Mode = Mode; end;
		Keybind.Key = Key;
		Keybind.Value = Key;
		if Keybind.Mode == "Always" then Keybind.Active = true;
		elseif Keybind.Mode == "Hold" then Keybind.Active = false; end;
		Library.Flags[ Flag ] = Keybind.Active;
		Refresh();
		if not Silent then
			call( Params.Callback, Keybind.Active );
			SyncLink();
		end;
	end;

	function Keybind : SetValue( Key ) Keybind : Set( Key ); end;
	function Keybind : SetMode( Mode ) Keybind : Set( Keybind.Key, Mode ); end;

	local ModeSelector = modeSelector( Button, Keybind, function( ModeName )
		Keybind : Set( Keybind.Key, ModeName );
	end );

	connect( Button.MouseButton1Click, function()
		if Keybind.Listening then return end;
		Keybind.Listening = true;
		Refresh();
		local Connection;
		Connection = UserInputService.InputBegan : Connect( function( Input )
			local Key;
			if Input.UserInputType == Enum.UserInputType.Keyboard then
				if Input.KeyCode == Enum.KeyCode.Escape or Input.KeyCode == Enum.KeyCode.Backspace then Key = false;
				else Key = Input.KeyCode; end;
			elseif Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.MouseButton2 or Input.UserInputType == Enum.UserInputType.MouseButton3 then
				Key = Input.UserInputType;
			else return; end;
			Connection : Disconnect();
			Keybind.Listening = false;
			Keybind : Set( Key or nil );
		end );
	end );

	connect( Button.MouseButton2Click, function()
		if Keybind.Listening then return end;
		if ModeSelector.Open then ModeSelector.Close() else ModeSelector.Show(); end;
	end );

	table.insert( Library.Keybinds, Keybind );
	Library.Options[ Flag ] = Keybind;
	Keybind : Set( Params.Default, Params.Mode, true );

	return Keybind;
end;

