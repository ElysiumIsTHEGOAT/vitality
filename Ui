	function Entry.Show()
		closePopups( Entry );
		local Viewport = workspace.CurrentCamera.ViewportSize;
		local Raw = Swatch.AbsolutePosition - getOrigin();
		local X = math.clamp( Raw.X, 6, math.max( Viewport.X - PopupWidth - 6, 6 ) );
