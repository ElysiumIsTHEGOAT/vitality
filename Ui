function Library : SetAccent( Color )
	if typeof( Color ) ~= "Color3" then return end;
	local Old = Theme[ "Accent" ];
	Theme[ "Accent" ] = Color;
	for _, Screen in { Gui, PopupGui, OverlayGui } do
		for _, Desc in Screen : GetDescendants() do
			if Desc : IsA( "GuiObject" ) then
				if Desc.BackgroundColor3 == Old then Desc.BackgroundColor3 = Color; end;
				if Desc : IsA( "TextLabel" ) or Desc : IsA( "TextButton" ) or Desc : IsA( "TextBox" ) then
					if Desc.TextColor3 == Old then Desc.TextColor3 = Color; end;
				end;
			elseif Desc : IsA( "UIStroke" ) then
				if Desc.Color == Old then Desc.Color = Color; end;
			elseif Desc : IsA( "UIGradient" ) then
				local Points = {}; local Changed = false;
				for _, Keypoint in ipairs( Desc.Color.Keypoints ) do
					if Keypoint.Value == Old then
						table.insert( Points, ColorSequenceKeypoint.new( Keypoint.Time, Color ) );
						Changed = true;
					else table.insert( Points, Keypoint ); end;
				end;
				if Changed then Desc.Color = ColorSequence.new( Points ); end;
			end;
		end;
	end;
	Library : RefreshKeybindHud();
end;

function Library : RefreshKeybindHud()
	for _, Child in Library.KeybindHudHolder : GetChildren() do
		if Child : IsA( "TextLabel" ) then Child : Destroy(); end;
	end;
	local Count = 0;
	for _, Keybind in Library.Keybinds do
		if Keybind.Key then
			Count = Count + 1;
			local Entry = Instance.new( "TextLabel" );
			Entry.FontFace = Library.BoldFont;
			Entry.Text = Keybind.Name .. " - " .. keyName( Keybind.Key ) .. " - (" .. Keybind.Mode .. ")";
			Entry.TextSize = Library.TextSize;
			Entry.TextColor3 = Keybind.Active and Theme[ "Accent" ] or Theme[ "Text" ];
			Entry.BackgroundTransparency = 1;
			Entry.BorderSizePixel = 0;
			Entry.Size = UDim2.new( 0, 0, 0, 16 );
			Entry.AutomaticSize = Enum.AutomaticSize.X;
			Entry.LayoutOrder = Count;
			Entry.TextXAlignment = Enum.TextXAlignment.Left;
			Entry.Name = "\0";
			Entry.Parent = Library.KeybindHudHolder;
			textStroke( Entry );
		end;
	end;
	KeybindHud.Visible = Library.ShowKeybindHud and Count > 0;
end;

