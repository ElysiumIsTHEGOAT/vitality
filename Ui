local function getOrigin() return Probe.AbsolutePosition; end;
local function getMousePoint() return UserInputService : GetMouseLocation() + getOrigin(); end;

local function isOver( Object )
	local Mouse = getMousePoint();
	local Position, Size = Object.AbsolutePosition, Object.AbsoluteSize;
	return Mouse.X >= Position.X and Mouse.X <= Position.X + Size.X and Mouse.Y >= Position.Y and Mouse.Y <= Position.Y + Size.Y;
end;

local function isPress( Input )
	return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch;
end;

local function isMove( Input )
	return Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch;
end;

local function drag( Object, OnMove, OnState )
	local Active = false;
	connect( Object.InputBegan, function( Input )
		if isPress( Input ) then
			Active = true;
			if OnState then OnState( true ); end;
			OnMove( getMousePoint() );
		end;
	end );
	connect( UserInputService.InputChanged, function( Input )
		if Active and isMove( Input ) then OnMove( getMousePoint() ); end;
	end );
	connect( UserInputService.InputEnded, function( Input )
		if Active and isPress( Input ) then
			Active = false;
			if OnState then OnState( false ); end;
		end;
	end );
end;

local function draggable( Frame )
	local Dragging = false;
	local DragStart, StartPosition;
	connect( Frame.InputBegan, function( Input )
		if isPress( Input ) then
			Dragging = true;
			DragStart = Input.Position;
			StartPosition = Frame.Position;
		end;
	end );
	connect( UserInputService.InputChanged, function( Input )
		if Dragging and isMove( Input ) then
			local Delta = Input.Position - DragStart;
			Frame.Position = UDim2.new( StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y );
		end;
	end );
	connect( UserInputService.InputEnded, function( Input )
		if isPress( Input ) then Dragging = false; end;
	end );
end;

local function closePopups( Except )
	for _, Popup in Library.Popups do
		if Popup ~= Except and Popup.Open then Popup.Close(); end;
	end;
end;

local function getDate()
	local Day = tonumber( os.date( "%d" ) );
	local Suffix = "th";
	if Day % 100 < 11 or Day % 100 > 13 then
		local Last = Day % 10;
		if Last == 1 then Suffix = "st"; elseif Last == 2 then Suffix = "nd"; elseif Last == 3 then Suffix = "rd"; end;
	end;
	return os.date( "%b " ) .. Day .. Suffix .. ". " .. os.date( "%Y" );
end;

